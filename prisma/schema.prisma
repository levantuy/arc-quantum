generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt         @id @default(autoincrement())
  address       String         @unique
  isAdmin       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  adminNonces   AdminNonce[]
  adminSessions AdminSession[]
  auditLogs     AuditLog[]
  transactions  Transaction[]
}

model Transaction {
  id           BigInt   @id @default(autoincrement())
  hash         String   @unique
  from         String
  to           String
  amount       String
  status       String
  userId       BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  txType       String   @default("unknown")
  amountIn     String?
  amountOut    String?
  tokenIn      String?
  tokenOut     String?
  chainId      Int?
  explorerUrl  String?
  errorMessage String?
  confirmedAt  DateTime?
  user         User?    @relation(fields: [userId], references: [id])

  @@index([from, createdAt(sort: Desc)])
  @@index([txType, createdAt(sort: Desc)])
}

model Token {
  id        BigInt   @id @default(autoincrement())
  address   String
  name      String?
  symbol    String
  decimals  Int
  chainId   Int
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([address, chainId])
}

model BridgeConfig {
  id        BigInt   @id @default(autoincrement())
  chainFrom Int
  chainTo   Int
  minAmount String
  maxAmount String
  fee       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainFrom, chainTo])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  action       String
  detail       String?
  oldData      String?
  newData      String?
  adminId      BigInt?
  adminAddress String
  createdAt    DateTime @default(now())
  admin        User?    @relation(fields: [adminId], references: [id])
}

model AdminNonce {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt?
  address   String
  nonce     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])

  @@index([address, nonce])
  @@index([expiresAt])
}

model AdminSession {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}

/// Bridge transaction record for cross-chain transfers
model BridgeTransaction {
  id           BigInt                 @id @default(autoincrement())
  userAddress  String
  fromChainId  Int
  toChainId    Int
  tokenAddress String
  amount       String
  status       String
  txHashSource String?
  txHashDest   String?
  errorMessage String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  logs         BridgeTransactionLog[]

  @@index([userAddress, createdAt(sort: Desc)])
  @@index([fromChainId, toChainId, createdAt(sort: Desc)])
}

/// Audit log for each step in a bridge transaction
model BridgeTransactionLog {
  id                  BigInt            @id @default(autoincrement())
  bridgeTransactionId BigInt
  step                String
  detail              String?
  createdAt           DateTime          @default(now())
  bridgeTransaction   BridgeTransaction @relation(fields: [bridgeTransactionId], references: [id])

  @@index([bridgeTransactionId, createdAt])
}
