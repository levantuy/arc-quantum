// Prisma schema for Arc Quantum DeFi App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt   @id @default(autoincrement())
  address   String   @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
  adminSessions AdminSession[]
  adminNonces AdminNonce[]
  auditLogs   AuditLog[]
}

model Transaction {
  id           BigInt   @id @default(autoincrement())
  hash         String   @unique
  txType       String   @default("unknown")
  from         String
  to           String
  amount       String
  amountIn     String?
  amountOut    String?
  tokenIn      String?
  tokenOut     String?
  chainId      Int?
  status       String
  explorerUrl  String?
  errorMessage String?
  user         User?    @relation(fields: [userId], references: [id])
  userId       BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([from, createdAt(sort: Desc)])
  @@index([txType, createdAt(sort: Desc)])
}

model Token {
  id        BigInt   @id @default(autoincrement())
  address   String
  name      String?
  symbol    String
  decimals  Int
  chainId   Int
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([address, chainId])
}

model BridgeConfig {
  id        BigInt   @id @default(autoincrement())
  chainFrom Int
  chainTo   Int
  minAmount String
  maxAmount String
  fee       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainFrom, chainTo])
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  action      String
  detail      String?
  oldData     String?
  newData     String?
  admin       User?    @relation(fields: [adminId], references: [id])
  adminId     BigInt?
  adminAddress String
  createdAt   DateTime @default(now())
}

model AdminNonce {
  id        BigInt   @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    BigInt?
  address   String
  nonce     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([address, nonce])
  @@index([expiresAt])
}

model AdminSession {
  id          BigInt   @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      BigInt
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

/// Bridge transaction record for cross-chain transfers
model BridgeTransaction {
  id            BigInt   @id @default(autoincrement())
  userAddress   String
  fromChainId   Int
  toChainId     Int
  tokenAddress  String
  amount        String
  status        String   // pending, success, failed
  txHashSource  String?  // hash giao dịch trên chain nguồn
  txHashDest    String?  // hash giao dịch trên chain đích
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  logs          BridgeTransactionLog[]

  @@index([userAddress, createdAt(sort: Desc)])
  @@index([fromChainId, toChainId, createdAt(sort: Desc)])
}

/// Audit log for each step in a bridge transaction
model BridgeTransactionLog {
  id                  BigInt   @id @default(autoincrement())
  bridgeTransaction   BridgeTransaction @relation(fields: [bridgeTransactionId], references: [id])
  bridgeTransactionId BigInt
  step                String   // Tên bước xử lý (init, lock, wait, mint, done, error...)
  detail              String?  // Thông tin chi tiết (JSON/text)
  createdAt           DateTime @default(now())

  @@index([bridgeTransactionId, createdAt])
}
